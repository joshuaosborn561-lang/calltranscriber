# Google Drive service account JSON (entire JSON blob as a single line / string)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Drive folder containing call recordings (.amr) and sidecar .json metadata files
DRIVE_RECORDINGS_FOLDER_ID=

# Drive folder where transcript .docx files are uploaded (falls back to DRIVE_RECORDINGS_FOLDER_ID if blank)
DRIVE_TRANSCRIPTS_FOLDER_ID=

# Comma-separated recording extensions to process (no leading dots)
RECORDING_EXTENSIONS=amr

# Skip recordings shorter than this many seconds (voicemails / misdials)
MIN_DURATION_SECONDS=15

# Supabase project URL and service role key (server-side only — never expose as anon)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API key used for gpt-4o-mini-transcribe
OPENAI_API_KEY=
