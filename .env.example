# OpenAI API key (gpt-4o-mini-transcribe)
OPENAI_API_KEY=

# Google OAuth (same client as replyhandler Gmail/Drive)
# Aliases GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET also work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional fallback instead of OAuth: entire service-account JSON as a string
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Recordings root (Cube ACR). CUBE_ACR_DRIVE_FOLDER_ID also works.
DRIVE_RECORDINGS_FOLDER_NAME=Cube ACR
# DRIVE_RECORDINGS_FOLDER_ID=
# CUBE_ACR_DRIVE_FOLDER_ID=

# Optional: force all transcripts into one folder.
# Default is the same date subfolder as each recording.
# DRIVE_TRANSCRIPTS_FOLDER_ID=

# Comma-separated recording extensions (no dots). Date subfolders are scanned recursively.
RECORDING_EXTENSIONS=amr

# Only transcribe calls longer than MIN and shorter than MAX (seconds)
MIN_DURATION_SECONDS=120
MAX_DURATION_SECONDS=1800

# Only backfill / watch the last N days (rolling). Default 3.
LOOKBACK_DAYS=3
# Optional absolute floor (if newer than the lookback cutoff, it wins)
# PROCESS_CREATED_AFTER=2026-08-04T17:00:00Z

# Optional: max new files to handle per poll cycle (omit for no limit)
# MAX_FILES_PER_RUN=5

# Continuous Drive poll interval (seconds). Default 30 for ~60s turnaround.
# Set to 0 for a one-shot run.
POLL_INTERVAL_SECONDS=30

# Split long calls into this many seconds per OpenAI request (default 600)
# TRANSCRIBE_CHUNK_SECONDS=600
