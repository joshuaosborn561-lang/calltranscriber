# OpenAI API key (gpt-4o-mini-transcribe)
OPENAI_API_KEY=

# Google OAuth (preferred — same style as replyhandler on Railway)
# Paste a refresh token once; the job refreshes access tokens automatically.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional fallback instead of OAuth: entire service-account JSON as a string
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Recordings root. Prefer folder name (searches Drive); or set an explicit ID.
DRIVE_RECORDINGS_FOLDER_NAME=Cube ACR
# DRIVE_RECORDINGS_FOLDER_ID=

# Where to upload .docx transcripts (defaults to the recordings root folder)
# DRIVE_TRANSCRIPTS_FOLDER_ID=

# Comma-separated recording extensions (no dots). Date subfolders are scanned recursively.
RECORDING_EXTENSIONS=amr

# Skip recordings shorter than this many seconds
MIN_DURATION_SECONDS=15
